generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ChatLog {
  id          String   @id @default(cuid())
  sessionId   String
  userMessage String
  category    String?
  createdAt   DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
}
